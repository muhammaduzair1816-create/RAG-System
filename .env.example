# ---------------------------------------------------------------------------
# Copy this file to `.env` and fill in your own keys. `.env` is git-ignored.
# ---------------------------------------------------------------------------

# --- Pinecone (https://app.pinecone.io) ---
PINECONE_API_KEY=your-pinecone-api-key-here
PINECONE_INDEX_NAME=rag-pdf-index
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1

# --- LLM provider (https://console.groq.com/keys) ---
GROQ_API_KEY=your-groq-api-key-here
GROQ_MODEL=llama-3.3-70b-versatile

# --- Embedding backend: "sentence-transformers" (local) or "pinecone" (hosted) ---
EMBEDDING_BACKEND=sentence-transformers
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384

# --- Retrieval defaults (overridable from the UI) ---
DEFAULT_CHUNK_SIZE=800
DEFAULT_CHUNK_OVERLAP=150
DEFAULT_TOP_K=5
DEFAULT_SIMILARITY_THRESHOLD=0.35

# --- OCR fallback for scanned / image-only PDFs ---
# OCR runs automatically on pages with no extractable text. It needs the
# Tesseract and Poppler system programs (see README §3); without them the app
# still runs normally and only warns when a scanned PDF is uploaded.
OCR_ENABLED=true
OCR_LANGUAGE=eng
OCR_DPI=300
# A page yielding fewer than this many characters is treated as a scan.
OCR_MIN_CHARS=80
# Safety valve: never OCR more than this many pages in one document.
OCR_MAX_PAGES=50

# Only needed when the binaries are not on PATH (common on Windows).
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
# POPPLER_PATH=C:\poppler\Library\bin

# --- Speech-to-text for spoken questions ---
# The microphone in the Ask tab transcribes locally with Whisper. The model
# downloads automatically on first use (~75 MB for base.en).
STT_ENABLED=true
# tiny.en / base.en / small.en / medium / large-v3 — bigger is slower but better.
STT_MODEL=base.en
STT_DEVICE=cpu
STT_COMPUTE_TYPE=int8
# Leave blank to auto-detect the spoken language.
STT_LANGUAGE=
STT_BEAM_SIZE=5
STT_MAX_AUDIO_MB=25

# --- Limits ---
MAX_PDF_SIZE_MB=20
